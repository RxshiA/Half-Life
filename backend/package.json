{
  "name": "courier-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Courier service backend API (Express 5 + Prisma 7 + TypeScript 6)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:db": "tsx scripts/prepare-test-db.ts",
    "test": "jest --forceExit --passWithNoTests",
    "test:coverage": "jest --coverage --forceExit",
    "test:unit": "jest --forceExit --testPathPattern='\\.(test)\\.ts$' --testPathIgnorePatterns='integration'",
    "test:integration": "jest --forceExit --testPathPattern='integration\\.test\\.ts$'",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset --force",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pino": "^9.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.4.0",
    "jest-mock-extended": "^4.0.0",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.0.0",
    "prisma": "^6.14.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  }
}
